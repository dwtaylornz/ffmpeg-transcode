{
  "global_settings": {
    "min_threads": 1,
    "max_threads": 8,
    "gpu_target_pct": 80,
    "gpu_ramp_wait": 60,
    "gpu_check_interval": 10,
    "vcn_sample_interval": 1,
    "ffmpeg_input_params": "-err_detect ignore_err -ignore_unknown -vaapi_device /dev/dri/renderD128",
    "scan_at_start": 1,
    "restart_queue": 720,
    "ffmpeg_timeout": 6000,
    "ffmpeg_logging": "error",
    "ffmpeg_min_diff": 5,
    "ffmpeg_max_diff": 95,
    "move_file": 1,
    "duration_tolerance": 30,
    "ffmpeg_nice_priority": 15,
    "skip_file": "./skip.csv",
    "sleep_before_move": 5,
    "sleep_after_move": 2,
    "output_path": "/dev/shm/ffmpeg-transcode",
    "shm_reserve_safety_pct": 130,
    "shm_reserve_floor_mb": 200,
    "audio_codec": "opus",
    "audio_encoder": "libopus",
    "audio_vbr": 0,
    "audio_bitrate": "128k",
    "audio_containers": "mkv,webm",
    "audio_fallback_codec": "ac3",
    "audio_fallback_bitrate": "224k",
    "audio_channels": 2,
    "audio_sample_rate": 48000,
    "audio_max_tracks": 1,
    "audio_min_bitrate_kbps": 448,
    "audio_preferred_languages": "eng,en",
    "audio_always_reencode_codecs": "truehd,mlp,dts,flac,wavpack,alac,pcm_*",
    "audio_lfe_fold": 1,
    "audio_limiter": 1,
    "audio_limiter_limit": 0.95,
    "audio_max_jobs": 3,
    "audio_catchup": 1,
    "ffmpeg_retry_attempts": 4,
    "error_log_dir": "./transcode-errors",
    "error_log_max_files": 200
  },
  "configurations": [
    {
      "name": "movies",
      "media_path": "/videos/movies",
      "min_video_size": 0,
      "min_video_age": 10,
      "ffmpeg_output_params": "-vf 'format=nv12,hwupload' -c:v av1_vaapi -b:v 5M -maxrate 10M -bufsize 10M -max_muxing_queue_size 9999",
      "video_codec_skip_list": "av1"
    },
    {
      "name": "series",
      "media_path": "/videos/series",
      "min_video_size": 0,
      "min_video_age": 10,
      "ffmpeg_output_params": "-vf 'format=nv12,hwupload' -c:v av1_vaapi -b:v 5M -maxrate 10M -bufsize 10M -max_muxing_queue_size 9999",
      "video_codec_skip_list": "av1"
    }
  ]
}
